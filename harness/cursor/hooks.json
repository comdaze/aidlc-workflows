{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts session-start" }
    ],
    "sessionEnd": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts session-end" }
    ],
    "beforeSubmitPrompt": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts mint" }
    ],
    "preToolUse": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts guards" }
    ],
    "postToolUse": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts audit-and-sensors" },
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts runtime-compile" }
    ],
    "preCompact": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts validate-state" }
    ],
    "stop": [
      { "command": "bun .cursor/hooks/aidlc-cursor-adapter.ts stop" }
    ]
  }
}
